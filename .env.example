# --- Server ---
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
SITE_URL=http://localhost:5173
# Origin tambahan dipisah koma; kosongkan untuk same-origin saja.
ALLOWED_ORIGINS=
TRUST_PROXY=0
DEMO_MODE=true

# --- Database (replica set wajib untuk transaksi) ---
MONGODB_URI=mongodb://127.0.0.1:27018/teduh?replicaSet=rs0
MONGODB_DB=teduh

# --- Sesi ---
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_NAME=teduh_sid

# --- MFA admin (32 byte base64; wajib untuk bootstrap admin) ---
MFA_ENCRYPTION_KEY=

# --- Pembayaran ---
# simulation hanya boleh di development/test. Produksi wajib midtrans.
PAYMENT_ADAPTER=simulation
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_API_BASE=https://api.sandbox.midtrans.com
MIDTRANS_SNAP_API_BASE=https://app.sandbox.midtrans.com
# Produksi: app.midtrans.com. Sandbox: app.sandbox.midtrans.com
MIDTRANS_ALLOWED_REDIRECT_HOSTS=app.sandbox.midtrans.com
SNAP_EXPIRY_MINUTES=60
PAYMENT_METHOD_WINDOW_MINUTES=1440
RESERVATION_MINUTES=1440
RECONCILE_INTERVAL_SECONDS=120
# Label kanal yang aktif di akun merchant (dipisah koma). Kosongkan bila belum dikonfirmasi.
PAYMENT_CHANNELS=QRIS,Transfer Virtual Account,Dompet digital
CARD_PAYMENT_ENABLED=false

# --- Email reset kata sandi ---
EMAIL_MODE=file
MAIL_DIR=var/mail
MAIL_FROM=Teduh <no-reply@teduh.example>

# --- Rate limit (disimpan di MongoDB agar aman multi-instance) ---
RATE_LIMIT_DISABLED=false
